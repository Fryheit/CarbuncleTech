<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SeleCR Settings"
    Width="686" Height="800"
    MinWidth="686" MinHeight="450"
    WindowStartupLocation="CenterScreen"
    Background="#FF232326"
    Foreground="#FFEDEDED">
    <Window.Resources>
        <SolidColorBrush x:Key="SlotBrush" Color="#FF3A3A40"/>
        <SolidColorBrush x:Key="SlotBorderBrush" Color="#FF4A4A52"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD7A857"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#FFB8B8BE"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Flat underline-style tabs: dim text normally, bright + gold underline when selected. -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="Transparent" Padding="18,7,18,0" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="HeaderText" Text="{TemplateBinding Header}"
                                           FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}"/>
                                <Rectangle x:Name="Underline" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="Transparent" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderText" Property="Foreground" Value="#FFEDEDED"/>
                                <Setter TargetName="Underline" Property="Fill" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderText" Property="Foreground" Value="#FFEDEDED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One job slot: icon | job name over routine picker. Fixed footprint comes from the
             WrapPanel's ItemWidth so every column lines up regardless of name length. -->
        <DataTemplate x:Key="RoutineSlotTemplate">
            <Border Margin="4" Padding="8,6" CornerRadius="4"
                    Background="{StaticResource SlotBrush}"
                    BorderBrush="{StaticResource SlotBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{Binding IconPath}"
                           Width="34" Height="34" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDimBrush}" Margin="1,0,0,3"/>
                        <ComboBox IsEditable="False" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AvailableRoutines}"
                                  SelectedItem="{Binding Routine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- One role group: accent title + hairline rule over its slots, on the plain window
             background (slot tiles are the only raised surface). Slots wrap at a fixed item
             width (210) so at least three fit side-by-side at the window's MinWidth. Groups
             carry NO horizontal margin/padding of their own, so slot columns land on the same
             210px grid in every group — a group that starts after a 2-slot neighbor (Hand and
             Land after Limited Jobs) lines up exactly with the third column above it. -->
        <DataTemplate x:Key="RoleGroupTemplate">
            <Border Margin="0,4" Padding="0,2,0,4">
                <StackPanel>
                    <DockPanel Margin="4,0,4,6">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <Rectangle Height="1" Margin="10,1,0,0" VerticalAlignment="Center"
                                   Fill="{StaticResource SlotBorderBrush}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource RoutineSlotTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="210"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RoleGroupsPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <TabControl Margin="10,8,10,10" Background="Transparent" BorderThickness="0" Padding="0">
        <TabItem Header="PVE">
            <DockPanel Margin="0,10,0,0">
                <Border DockPanel.Dock="Bottom" Padding="6,9,6,1" Margin="0,4,0,0"
                        BorderBrush="{StaticResource SlotBorderBrush}" BorderThickness="0,1,0,0">
                    <CheckBox Content="Enable automatic routine selection in PVE areas"
                              IsChecked="{Binding AutoSelectPve, Mode=TwoWay}"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="0,0,2,0" ItemsSource="{Binding PveGroups}"
                                  ItemTemplate="{StaticResource RoleGroupTemplate}"
                                  ItemsPanel="{StaticResource RoleGroupsPanel}"/>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        <TabItem Header="PVP">
            <DockPanel Margin="0,10,0,0">
                <Border DockPanel.Dock="Bottom" Padding="6,9,6,1" Margin="0,4,0,0"
                        BorderBrush="{StaticResource SlotBorderBrush}" BorderThickness="0,1,0,0">
                    <CheckBox Content="Enable automatic routine selection in PVP areas"
                              IsChecked="{Binding AutoSelectPvp, Mode=TwoWay}"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="0,0,2,0" ItemsSource="{Binding PvpGroups}"
                                  ItemTemplate="{StaticResource RoleGroupTemplate}"
                                  ItemsPanel="{StaticResource RoleGroupsPanel}"/>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
