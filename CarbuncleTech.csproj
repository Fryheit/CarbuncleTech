<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CarbuncleTech</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <PackageProjectUrl>https://github.com/catrenelle/CarbuncleTech/</PackageProjectUrl>
    <AssemblyVersion>2026.9.9.1</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RebornBuddy.ReferenceAssemblies" Version="1.0.914" />
  </ItemGroup>

  <!-- RebornBuddy.ReferenceAssemblies ships a native (non-.NET) Ijwhost.dll inside its managed
       lib/net10.0-windows folder. NuGet exposes every DLL in that folder as a compile-time reference
       candidate, but ResolveAssemblyReferences can't read CLR metadata from a native PE, producing a
       harmless MSB3246 warning every build. Drop it from the reference set before it's resolved. -->
  <Target Name="RemoveIjwhostNativeReference" AfterTargets="ResolveLockFileReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.FileName)' == 'Ijwhost'" />
    </ItemGroup>
  </Target>
</Project>
